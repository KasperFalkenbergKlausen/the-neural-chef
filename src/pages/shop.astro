---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import gearData from '../data/affiliateGear.json';
import { getAmazonAffiliateLink } from '../utils/affiliate';
import gearHeroImage from '../assets/images/neural_kitchen_gear.jpg';

// Dynamically extract unique categories from products that actually have gear
const dynamicCategories = ['All Gear', ...new Set(Object.values(gearData).map(item => item.category))];
const categories = dynamicCategories;

const products = Object.values(gearData).map((item) => ({
  ...item,
  computedUrl: getAmazonAffiliateLink(item.amazonAsin)
}));
---

<BaseLayout 
  title="Culinary Hardware & Gear - The Neural Chef" 
  description="Precision kitchen appliances, tools, and hardware recommended by The Neural Chef to compile our algorithmic recipes."
>
  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 z-0">
      <Image 
        src={gearHeroImage} 
        alt="Neural Chef Kitchen Equipment" 
        class="w-full h-full object-cover opacity-65 brightness-115 contrast-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-950/50 to-slate-900/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-800/60 text-cyan-400 text-xs font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          Hardware Specifications // Verified Tools
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold tracking-tight mb-6">
          Culinary <span class="text-cyan-400">Hardware</span> Lab
        </h1>

        <p class="text-slate-300 text-base md:text-lg leading-relaxed mb-6">
          Every algorithmic recipe requires deterministic kitchen hardware. We’ve selected reliable, high-precision tools on Amazon to eliminate volumetric chaos and ensure optimal thermal transfer.
        </p>

        <!-- Compliance disclosure notice directly in hero -->
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-xs text-slate-400 flex items-start gap-2.5">
          <span class="text-amber-400 text-sm">ℹ️</span>
          <p>
            <strong class="text-slate-200">Affiliate Disclosure:</strong> As an Amazon Associate, The Neural Chef earns from qualifying purchases. Clicking these links redirects you directly to Amazon with no additional cost to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Storefront Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Spotlight / Featured Gear Banner (Dynamically activated if ?item=... or anchor matches) -->
    <div id="spotlight-container" class="hidden mb-12">
      <div class="relative overflow-hidden bg-white rounded-3xl border-2 border-cyan-500/40 p-6 md:p-8 shadow-xl shadow-cyan-950/5">
        <!-- Background cyan subtle accent glow -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-700 text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>
            FEATURED HARDWARE SPOTLIGHT // AS SEEN ON PINTEREST
          </div>
          <button id="close-spotlight" class="text-xs text-slate-400 hover:text-slate-700 transition-colors cursor-pointer flex items-center gap-1 font-medium">
            <span>Show All Gear</span>
            <span class="text-base leading-none">&times;</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-5 bg-slate-50/80 rounded-2xl p-6 border border-slate-200/80 flex items-center justify-center">
            <img id="spotlight-image" src="" alt="Featured Gear" class="max-h-64 max-w-full object-contain filter drop-shadow-md" />
          </div>

          <div class="md:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span id="spotlight-badge" class="text-[10px] uppercase font-mono font-bold tracking-wider text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-0.5 rounded-md"></span>
                <span class="text-[10px] font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-md flex items-center gap-1">
                  <span>★</span> Amazon Prime Verified
                </span>
              </div>

              <h2 id="spotlight-name" class="text-2xl md:text-3xl font-display font-extrabold text-slate-900 mb-2 leading-tight"></h2>
              <p id="spotlight-tagline" class="text-xs font-mono text-cyan-600 font-semibold mb-3"></p>
              <p id="spotlight-description" class="text-xs md:text-sm text-slate-600 leading-relaxed mb-6"></p>

              <div class="mb-6">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2 font-mono">// Verified Lab Specifications:</div>
                <ul id="spotlight-features" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700"></ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a 
                id="spotlight-link" 
                href="" 
                target="_blank" 
                rel="noopener noreferrer sponsored"
                class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 hover:from-cyan-400 hover:to-cyan-500 text-slate-950 font-extrabold text-sm rounded-xl transition-all shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/30 cursor-pointer"
              >
                <span>Check Verified Price on Amazon</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <span class="text-[11px] font-mono text-slate-400 text-center sm:text-left">
                Ships via Amazon Prime &bull; 30-Day Return
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200/80">
      <!-- Category Pills -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-none" id="category-filters">
        {categories.map((cat, idx) => (
          <button 
            type="button"
            data-category={cat}
            class={`category-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap ${
              idx === 0 
                ? 'bg-slate-900 text-white shadow-sm' 
                : 'bg-white text-slate-650 hover:bg-slate-100 hover:text-slate-900 border border-slate-200/80'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Live Search Input -->
      <div class="relative w-full md:w-72">
        <input 
          type="text" 
          id="product-search" 
          placeholder="Filter equipment..." 
          class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 transition-all shadow-xs"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
          <path d="m21 21-4.3-4.3" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>

    <!-- Product Grid -->
    <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((item) => (
        <article 
          id={item.id}
          class="product-card group flex flex-col justify-between bg-white rounded-2xl border border-slate-200/80 hover:border-cyan-500/40 p-6 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 relative scroll-mt-28"
          data-category={item.category}
          data-title={item.name.toLowerCase()}
          data-tagline={item.tagline.toLowerCase()}
          data-asin={item.amazonAsin.toLowerCase()}
        >
          <div>
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[10px] uppercase font-bold tracking-wider text-cyan-600 bg-cyan-50 border border-cyan-100 px-2.5 py-0.5 rounded-md">
                {item.category}
              </span>
              {item.badge && (
                <span class="text-[10px] font-bold text-slate-600 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-md">
                  {item.badge}
                </span>
              )}
            </div>

            <!-- Product Image (if available) -->
            {item.imageUrl && (
              <div class="w-full h-44 mb-4 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-center p-3 overflow-hidden">
                <img 
                  src={item.imageUrl} 
                  alt={item.name} 
                  loading="lazy" 
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" 
                />
              </div>
            )}

            <!-- Product Header -->
            <h3 class="text-lg font-display font-bold text-slate-900 group-hover:text-cyan-700 transition-colors mb-1 leading-snug">
              {item.name}
            </h3>
            <p class="text-xs font-mono text-cyan-600 font-semibold tracking-wide mb-3">
              // {item.tagline}
            </p>

            <p class="text-xs text-slate-655 leading-relaxed mb-5">
              {item.description}
            </p>

            <!-- Feature Bullet points -->
            {item.features && (
              <ul class="space-y-1.5 mb-6 text-xs text-slate-600 bg-slate-50/70 p-3.5 rounded-xl border border-slate-100">
                {item.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <span class="text-cyan-500 text-xs">✔</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <!-- Card Bottom / Action -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
            <span class="text-[11px] font-mono text-slate-400">
              Verified Specs
            </span>

            <a 
              href={item.computedUrl} 
              target="_blank" 
              rel="noopener noreferrer sponsored"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-slate-900 hover:bg-cyan-600 text-white text-xs font-bold rounded-xl transition-all shadow-sm hover:shadow-md cursor-pointer"
            >
              <span>Check Price on Amazon</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State Message -->
    <div id="no-results" class="hidden text-center py-16">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-base font-bold text-slate-800 mb-1">No matching hardware found</h3>
      <p class="text-xs text-slate-500">Try broadening your search term or switching back to "All Gear".</p>
    </div>
  </section>

  <!-- FAQ / Why Buy Through Neural Chef -->
  <section class="bg-slate-50 py-16 border-t border-slate-200/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-display font-bold text-slate-900 mb-2">How Our Affiliate Lab Works</h2>
        <p class="text-xs text-slate-600 max-w-lg mx-auto">
          We don't stock inventory. Instead, we link directly to verified Amazon hardware that aligns with our AI recipes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-655">
        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-2xs">
          <div class="text-base mb-2 font-bold text-slate-900 flex items-center gap-2">
            <span>🛡️</span> Zero Cost To You
          </div>
          <p>You pay the exact same price on Amazon as anyone else. Amazon simply credits our algorithmic research a minor referral fee.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-2xs">
          <div class="text-base mb-2 font-bold text-slate-900 flex items-center gap-2">
            <span>⚡</span> Automated Compatibility
          </div>
          <p>Every tool is chosen to guarantee safety and temperature precision for our slow-cooked and braised recipes.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-2xs">
          <div class="text-base mb-2 font-bold text-slate-900 flex items-center gap-2">
            <span>📦</span> Amazon Prime & Fulfillment
          </div>
          <p>Ordering, shipping, returns, and customer service are handled completely by Amazon and their verified sellers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Serialized gear data for client-side spotlight -->
  <script id="gear-registry-data" type="application/json" set:html={JSON.stringify(Object.fromEntries(products.map(p => [p.id, p])))}></script>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.category-btn');
    const searchInput = document.getElementById('product-search');
    const cards = document.querySelectorAll('.product-card');
    const noResults = document.getElementById('no-results');

    let activeCategory = 'All Gear';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const title = card.getAttribute('data-title') || '';
        const tagline = card.getAttribute('data-tagline') || '';
        const asin = card.getAttribute('data-asin') || '';

        const matchesCat = activeCategory === 'All Gear' || cat === activeCategory;
        const matchesSearch = !searchQuery || 
          title.includes(searchQuery) || 
          tagline.includes(searchQuery) || 
          asin.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
          b.classList.add('bg-white', 'text-slate-650', 'border', 'border-slate-200/80');
        });
        btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-slate-650', 'border', 'border-slate-200/80');

        activeCategory = btn.getAttribute('data-category') || 'All Gear';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFilter();
      });
    }

    // Support URL parameters (e.g. ?category=... or ?search=... or ?item=...)
    const params = new URLSearchParams(window.location.search);
    const categoryParam = params.get('category');
    const searchParam = params.get('search');
    const itemParam = params.get('item') || (window.location.hash ? window.location.hash.substring(1) : null);

    // Spotlight Hardware Data injected from Astro
    const gearRegistry = JSON.parse(document.getElementById('gear-registry-data')?.textContent || '{}');
    const spotlightContainer = document.getElementById('spotlight-container');
    const closeSpotlightBtn = document.getElementById('close-spotlight');

    function activateSpotlight(itemId) {
      if (!gearRegistry || !spotlightContainer) return;
      const targetItem = gearRegistry[itemId];
      if (!targetItem) return;

      document.getElementById('spotlight-image').src = targetItem.imageUrl;
      document.getElementById('spotlight-image').alt = targetItem.name;
      document.getElementById('spotlight-name').textContent = targetItem.name;
      document.getElementById('spotlight-tagline').textContent = '// ' + targetItem.tagline;
      document.getElementById('spotlight-description').textContent = targetItem.description;
      document.getElementById('spotlight-badge').textContent = targetItem.category + ' // ' + (targetItem.badge || 'Verified');
      document.getElementById('spotlight-link').href = targetItem.computedUrl;

      const featList = document.getElementById('spotlight-features');
      featList.innerHTML = '';
      if (targetItem.features && Array.isArray(targetItem.features)) {
        targetItem.features.forEach(feat => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-1.5 bg-slate-50 border border-slate-200/80 p-2 rounded-lg text-slate-700';
          li.innerHTML = '<span class="text-cyan-600 font-bold text-xs">✔</span><span>' + feat + '</span>';
          featList.appendChild(li);
        });
      }

      spotlightContainer.classList.remove('hidden');
      setTimeout(() => {
        spotlightContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }

    if (closeSpotlightBtn) {
      closeSpotlightBtn.addEventListener('click', () => {
        spotlightContainer.classList.add('hidden');
      });
    }

    if (itemParam && gearRegistry[itemParam]) {
      activateSpotlight(itemParam);
    }

    if (categoryParam) {
      const decodedCat = decodeURIComponent(categoryParam);
      filterBtns.forEach(btn => {
        if (btn.getAttribute('data-category')?.toLowerCase() === decodedCat.toLowerCase()) {
          btn.click();
        }
      });
    }

    if (searchParam) {
      if (searchInput) {
        searchInput.value = searchParam;
        searchQuery = searchParam.toLowerCase().trim();
        applyFilter();
      }
    }

    // Highlight card if URL contains anchor hash (e.g. #slow-cooker)
    if (window.location.hash) {
      const targetId = window.location.hash.substring(1);
      const targetCard = document.getElementById(targetId);
      if (targetCard) {
        // Ensure parent category is visible if filtered
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('ring-4', 'ring-cyan-500', 'shadow-2xl');
          setTimeout(() => {
            targetCard.classList.remove('ring-4', 'ring-cyan-500', 'shadow-2xl');
          }, 3000);
        }, 150);
      }
    }
  });
</script>
