---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, description, prepTime, cookTime, servings, category, featuredImage } = recipe.data;
const slug = recipe.id.replace(/\.md$/, '').replace(/\.mdx$/, '');
---

<article class="group bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-cyan-550/30 transition-all duration-300 flex flex-col h-full">
  <a href={`/recipes/${slug}`} class="block relative aspect-video overflow-hidden bg-slate-100">
    <Image 
      src={featuredImage} 
      alt={title} 
      width={600}
      height={337}
      class="object-cover w-full h-full group-hover:scale-[1.03] transition-transform duration-500 ease-out"
    />
    <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-cyan-700 border border-slate-200/60 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">
      {category}
    </span>
  </a>

  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-4 text-xs text-slate-500 mb-3">
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {prepTime} prep
      </span>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
        {cookTime} cook
      </span>
    </div>

    <h3 class="text-xl font-bold text-slate-900 mb-2 line-clamp-1 group-hover:text-cyan-650 transition-colors">
      <a href={`/recipes/${slug}`}>
        {title}
      </a>
    </h3>
    
    <p class="text-slate-600 text-sm line-clamp-2 mb-4 flex-grow">
      {description}
    </p>

    <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
      <span class="text-xs font-medium text-slate-500">{servings} servings</span>
      <a href={`/recipes/${slug}`} class="text-xs font-semibold text-cyan-600 group-hover:text-cyan-700 inline-flex items-center gap-1 transition-colors">
        View Recipe 
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</article>
